// Renovate opens pull requests that update dependencies.
// Policy: weekly grouped PRs, security fixes right away, 7-day cooldown on
// everything, no automerge.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // pinGitHubActionDigests: every action is pinned to a commit SHA
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests'],
  timezone: 'Europe/Paris',
  labels: ['dependencies'],

  // Regular updates are opened once a week. Renovate still runs more often so
  // that security fixes (below) and the Dependency Dashboard stay current.
  schedule: ['before 6am on monday'],

  // No automerge
  automerge: false,

  // Do not even create the branch before the cooldown below has passed.
  internalChecksFilter: 'strict',

  // PRs for known vulnerabilities
  osvVulnerabilityAlerts: true,

  // List every known vulnerability in the Dependency Dashboard issue
  dependencyDashboardOSVVulnerabilitySummary: 'all',
  vulnerabilityAlerts: {
    labels: ['dependencies', 'security'],
    // Renovate drops the cooldown for security fixes by default
    minimumReleaseAge: '7 days',
  },

  packageRules: [
    {
      // 7-day cooldown on every version Renovate proposes
      matchUpdateTypes: ['major', 'minor', 'patch', 'pin', 'pinDigest', 'digest'],
      minimumReleaseAge: '7 days',
    },

    {
      // Keep the ranges in pyproject.toml (published on PyPI), update uv.lock only
      matchManagers: ['pep621'],
      rangeStrategy: 'update-lockfile',
    },

    // One weekly PR per ecosystem for minor and patch updates
    {
      matchManagers: ['pep621'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'Python (non-major)',
    },
    {
      matchDatasources: ['docker'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'Docker images (non-major)',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'GitHub Actions (non-major)',
    },

    {
      // uv is found as a Docker image (Dockerfile, workflows, python-lock.sh)
      // and as a PyPI package (constraints.uv below): one PR for every file
      matchPackageNames: ['ghcr.io/astral-sh/uv', 'uv'],
      groupName: 'uv',
    },
    {
      // Python and uv version changes are done by hand
      matchPackageNames: ['python', 'ghcr.io/astral-sh/uv', 'uv'],
      matchUpdateTypes: ['major', 'minor'],
      enabled: false,
    },
    {
      // openai is capped (<1.99.0) for openai-agents: both are updated by hand
      matchDatasources: ['pypi'],
      matchPackageNames: ['openai', 'openai-agents'],
      enabled: false,
    },
  ],

  // uv version Renovate uses to regenerate uv.lock (Renovate updates it itself)
  constraints: {
    uv: '0.13.9',
  },

  // Python dependencies live in pyproject.toml and uv.lock
  pep621: {
    // Weekly refresh of every locked package, within the cooldown
    lockFileMaintenance: {
      enabled: true,
    },
  },

  customManagers: [
    {
      // uv version in scripts/python-lock.sh and the workflows
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)scripts/python-lock\\.sh$/',
        '/(^|/)\\.github/workflows/(ci|publish)\\.yml$/',
      ],
      // UV_VERSION=0.13.9 (shell) or UV_VERSION: '0.13.9' (YAML)
      matchStrings: ["UV_VERSION[=:] ?'?(?<currentValue>\\d[^'\\s]*)"],
      depNameTemplate: 'ghcr.io/astral-sh/uv',
      datasourceTemplate: 'docker',
    },
  ],
}
